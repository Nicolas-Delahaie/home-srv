{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "vulnerabilityAlerts": { "enabled": false },
  "separateMajorMinor": false,
  "groupName": "weekly updates",
  "assignees": ["Nicolas-Delahaie"],
  "packageRules": [
    { "matchUpdateTypes": ["patch"], "labels": ["patch"] },
    { "matchUpdateTypes": ["minor"], "labels": ["minor"] },
    { "matchUpdateTypes": ["major"], "labels": ["major"] },
    {
      "description": "Upstream image exposes no org.opencontainers.image.source label",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["portainer/portainer-ce"],
      "sourceUrl": "https://github.com/portainer/portainer"
    },
    {
      "description": "Upstream image exposes no org.opencontainers.image.source label",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/blakeblackshear/frigate"],
      "sourceUrl": "https://github.com/blakeblackshear/frigate"
    },
    {
      "description": "Verbose release notes. No sourceUrl: changelog not fetched",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "fetchChangeLogs": "off"
    },
    {
      "description": "Upstream image exposes no org.opencontainers.image.source label",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/myoung34/docker-github-actions-runner"],
      "sourceUrl": "https://github.com/myoung34/docker-github-actions-runner"
    },
    {
      "description": "Its changelog alone is ~50KB and truncates every other release note in the grouped PR (GitHub caps the body at ~60k chars)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/open-webui/open-webui"],
      "fetchChangeLogs": "off"
    }
  ],
  "customManagers": []
}
